{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2023",
    "module": "preserve",
    "erasableSyntaxOnly": true,
    "paths": {
      "@app-types/*": ["./src/app/types/*"],
      "@components/*": ["./src/app/pages/game/components/*"],
      "@directives/*": ["./src/app/directives/*"],
      "@env": ["./src/environments/environment"],
      "@guards/*": ["./src/app/guards/*"],
      "@pipes/*": ["./src/app/pipes/*"],
      "@services/*": ["./src/app/services/*"],

      // UI
      "@ui/alert": ["./src/app/ui/alert/src/index.ts"],
      "@ui/avatar": ["./src/app/ui/avatar/src/index.ts"],
      "@ui/badge": ["./src/app/ui/badge/src/index.ts"],
      "@ui/button": ["./src/app/ui/button/src/index.ts"],
      "@ui/input": ["./src/app/ui/input/src/index.ts"],
      "@ui/input-group": ["./src/app/ui/input-group/src/index.ts"],
      "@ui/skeleton": ["./src/app/ui/skeleton/src/index.ts"],
      "@ui/slider": ["./src/app/ui/slider/src/index.ts"],
      "@ui/spinner": ["./src/app/ui/spinner/src/index.ts"],
      "@ui/tooltip": ["./src/app/ui/tooltip/src/index.ts"],
      "@ui/utils": ["./src/app/ui/utils/src/index.ts"],
      "@ui/textarea": ["./src/app/ui/textarea/src/index.ts"],
      "@ui/field": ["./src/app/ui/field/src/index.ts"],
      "@ui/label": ["./src/app/ui/label/src/index.ts"],
      "@ui/separator": ["./src/app/ui/separator/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
